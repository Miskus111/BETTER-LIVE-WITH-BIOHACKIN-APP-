# ── Supabase (EU region, e.g. North EU / Stockholm) ─────────────────────────────
# Project Settings → API. The anon key is public (RLS protects data); the service role key is SECRET.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI coach (phase 7) ───────────────────────────────────────────────────────
# Also powers lab-report reading. Without a key the coach shows a notice and labs accept pasted text only.
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5
ANTHROPIC_MODEL=
# Coach messages per user per day while FREE_MODE is on (cost control)
COACH_DAILY_MESSAGE_LIMIT=40

# ── Billing (phase 8) — FREE_MODE=true unlocks everything and hides the paywall ─
FREE_MODE=true
# Optional: 1 = show "Sign in with Google" (enable the Google provider in Supabase → Auth → Providers first)
NEXT_PUBLIC_GOOGLE_AUTH=

# ── Affiliate partner programmes (query string assigned by each programme) ────
NEXT_PUBLIC_AFF_BRAINMARKET=
NEXT_PUBLIC_AFF_VILGAIN=

# ── Addresses ────────────────────────────────────────────────────────────────
# This app's own address (OAuth redirects, metadata)
NEXT_PUBLIC_SITE_URL=
# The public website (food pages, guides, legal pages); links to public paths are redirected there
NEXT_PUBLIC_WEB_URL=https://better-live-web.vercel.app

# ── Demo seed (npm run seed:demo) ─────────────────────────────────────────────────
DEMO_USER_EMAIL=demo@blwb.app
DEMO_USER_PASSWORD=
