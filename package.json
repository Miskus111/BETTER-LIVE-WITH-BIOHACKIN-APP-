{
  "name": "blwb-app",
  "version": "0.6.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "gen:seed": "tsx --tsconfig scripts/tsconfig.json scripts/gen-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx --tsconfig scripts/tsconfig.json scripts/seed-demo.ts",
    "test:rls": "tsx --tsconfig scripts/tsconfig.json scripts/test-rls.ts",
    "seed:reference": "tsx --tsconfig scripts/tsconfig.json scripts/seed-reference.ts",
    "check:db": "tsx --tsconfig scripts/tsconfig.json scripts/check-db.ts",
    "check": "npm run lint && npm run typecheck && npm run check:unused && npm test && npm run test:e2e",
    "sync:data": "tsx --tsconfig scripts/tsconfig.json scripts/sync-data.ts",
    "test:migrations": "node scripts/test-migrations.mjs",
    "check:data-sync": "tsx --tsconfig scripts/tsconfig.json scripts/check-data-sync.ts",
    "check:unused": "tsx --tsconfig scripts/tsconfig.json scripts/check-unused.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.4",
    "next-intl": "^4.15.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.1",
    "docx": "^9.16.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "@swc/core": true,
    "fsevents": true
  }
}
